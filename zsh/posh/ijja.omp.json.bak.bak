{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bg": "#3c3836",
    "fg": "#a89984"
  },
  "console_title_template": "{{if .Root}}[root] {{end}}{{.Shell}} in <{{.Folder}}>",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u250c",
          "foreground": "p:fg",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        },
        {
          "options": {
            "linux": "\uf17c",
            "macos": "\uf179",
            "ubuntu": "\uf31b",
            "windows": "\ue62a"
          },
          "template": "\u2800{{if .WSL}}\ue62a\u2800->\u2800{{end}}{{.Icon}}\u2800",
          "foreground": "#a89984",
          "background": "#282828",
          "type": "os",
          "style": "plain"
        },
        {
          "template": "\u2800\uf2c0\u2800{{.UserName}}@{{.HostName}}\u2800",
          "foreground": "#928374",
          "background": "#32302f",
          "type": "session",
          "style": "plain"
        },
        {
          "template": "|\u2800\uf489\u2800{{.Name}}\u2800",
          "foreground": "#928374",
          "background": "#32302f",
          "type": "shell",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "\u2800\ue0a0\u2800",
          "foreground": "#a89984",
          "background": "#282828",
          "type": "git",
          "style": "powerline"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "\u2800{{ .HEAD }}\u2800",
          "foreground": "#011627",
          "background": "#d79921",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if .Detached }}#d65d0e{{ end }}",
            "{{ if gt .Ahead 0 }}#b16286{{ end }}",
            "{{ if gt .Behind 0 }}#458588{{ end }}"
          ]
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "\u2800+{{ .Working.Added }}",
          "foreground": "#b8bb26",
          "background": "p:bg",
          "type": "git",
          "style": "powerline"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "\u2800~{{ .Working.Modified }}",
          "foreground": "#8ec07c",
          "background": "p:bg",
          "type": "git",
          "style": "powerline"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "\u2800-{{ .Working.Deleted }}",
          "foreground": "#fb4934",
          "background": "p:bg",
          "type": "git",
          "style": "powerline"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "\u2800?{{ .Working.Untracked }}\u2800",
          "foreground": "#fabd2f",
          "background": "p:bg",
          "type": "git",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "style": "austin",
            "threshold": 0
          },
          "template": "{{.FormattedMs}}",
          "foreground": "#8ec07c",
          "background": "transparent",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "options": {
            "time_format": "02/01/06 15:04"
          },
          "template": "<#8ec07c> · </>{{.CurrentDate | date .Format}}",
          "foreground": "#8ec07c",
          "background": "transparent",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "folder_icon": "\uf07b",
            "folder_separator_template": "<#458588> » </>",
            "home_icon": "\ueb06",
            "style": "agnoster"
          },
          "template": "<#p:fg>\u2514</><#83a598>[</> {{.Path}} <#83a598>]</>",
          "foreground": "p:fg",
          "background": "transparent",
          "type": "path",
          "style": "plain"
        },
        {
          "template": "{{ if gt .Code 0 }}->{{.Code}}{{ end }}",
          "foreground": "#cc241d",
          "background": "transparent",
          "type": "status",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "template": "%",
          "foreground": "#98971a",
          "background": "transparent",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{if gt .Code 0}}#cc241d{{end}}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 4,
  "final_space": true
}
